    "expo-keep-awake": "^56.0.3",
    "expo-linking": "^56.0.14",
    "expo-navigation-bar": "^56.0.3",
    "expo-print": "~56.0.4",
    "expo-router": "^56.2.11",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
