{
  "name": "setremote",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "SetRemote — PWA film-set. Sources dans web/, index.html (racine) généré par web/build.mjs et servi tel quel par GitHub Pages.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node web/build.mjs",
    "check:build": "node web/build.mjs --check",
    "check:equivalence": "node web/check-equivalence.mjs --ref 28ccb1d",
    "test": "node web/build.mjs --check && node --test --test-concurrency=2 \"tests/*.test.mjs\"",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 node --test tests/visual.test.mjs",
    "test:dmx": "node --test \"packages/dmx/test/*.test.js\"",
    "test:relay": "node --test \"relay/test/*.test.js\"",
    "notices": "node scripts/third-party-notices.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --check",
    "check:spdx": "node scripts/spdx-headers.mjs --check"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "ws": "8.22.0"
  }
}
