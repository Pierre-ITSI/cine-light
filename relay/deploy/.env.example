# ── SetRemote : relais et PWA auto-hébergés. Copier en « .env » puis adapter. ──
# Aucun secret ici : ce fichier ne contient que des réglages.

# Sous-domaine du relais et du STUN : enregistrement DNS A (et AAAA si IPv6)
# vers le VPS
RELAY_DOMAIN=hub.itsi-app.com

# Sous-domaine de la PWA (même VPS, même type d'enregistrement DNS)
APP_DOMAIN=set-remote.itsi-app.com

# Services lancés en plus du relais :
#   caddy : certificat TLS automatique et proxy sur les ports 80 et 443
#   stun  : coturn en STUN seul sur le port 3478 (UDP et TCP)
# Un proxy inverse occupe DÉJÀ le port 443 du VPS ? Mettre COMPOSE_PROFILES=stun
# et suivre variants/ (nginx ou Traefik).
COMPOSE_PROFILES=caddy,stun

# Preuve d'appartenance (relayAuth) : 1 = exigée (recommandé, la PWA l'envoie
# toujours), 0 = facultative.
RELAY_REQUIRE_AUTH=1

# Mémoire du TOFU (1re preuve vue pour chaque session) entre deux redémarrages,
# dans le volume Docker relay-data. Vide = mémoire seule : chaque redémarrage
# RÉARME le TOFU (la première connexion suivante fait foi).
RELAY_AUTH_FILE=/data/tofu.json

# Origines web autorisées, séparées par des virgules, ex. https://exemple.github.io
# Vide = toutes. Laisser vide si l'app native (page locale) doit se connecter.
RELAY_ORIGINS=

# Plafonds (valeurs adaptées à un petit VPS ; voir README.md, « Ressources »)
RELAY_MAX_SOCKETS=4000
RELAY_MAX_ROOMS=2000
RELAY_MEM_LIMIT_MB=384
# Sockets simultanés par adresse IP : tous les appareils d'un plateau derrière
# le même Wi-Fi partagent souvent une seule IPv4
RELAY_IP_MAX_SOCKETS=64

# Réseau Docker interne du relais (à changer seulement si « docker compose up »
# signale un chevauchement avec un réseau existant)
RELAY_SUBNET=172.30.53.0/24

# Port local (127.0.0.1 seulement) où le proxy inverse joint le relais
RELAY_LOCAL_PORT=8080

# ── Fichiers de la PWA (install-app-update.sh, update-app.sh) ──
# Dossier de l'hôte où le minuteur dépose les versions (lu par Caddy).
# Après un changement : relancer « sudo ./install-app-update.sh » puis
# « docker compose up -d ».
APP_ROOT=/srv/setremote-app
# Dépôt GitHub PUBLIC et branche publiés (archive téléchargée sans compte)
APP_REPO=pierre-itsi/cine-light
APP_BRANCH=main
# Connexions WebSocket permises à la PWA en plus du relais (CSP), séparées par
# des espaces. Broker MQTT public : à garder tant que l'app l'utilise
# (RELAY_URL vide), à vider (APP_CONNECT_EXTRA=) après la bascule vers le relais.
APP_CONNECT_EXTRA=wss://broker.hivemq.com:8884
